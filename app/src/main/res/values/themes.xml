<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MrzPruefer" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="MrzLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:inputType">textCapCharacters|textNoSuggestions|textVisiblePassword</item>
        <item name="android:maxLines">1</item>
        <item name="android:importantForAutofill">no</item>
        <!-- Tastatur soll Eingaben nicht lernen (Inkognito-Modus bei Gboard, SwiftKey u. a.) -->
        <item name="android:imeOptions">flagNoPersonalizedLearning|actionNext</item>
    </style>
</resources>
